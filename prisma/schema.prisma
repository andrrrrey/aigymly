generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  emailVerified Boolean   @default(false)
  sex           String?
  avatarUrl     String?
  units         String?   @default("metric")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tokens        Token[]
  workouts      Workout[]
  programs      Program[]
  subscription  Subscription?
  payments      Payment[]
  aiUsage       AiUsage[]
  aiStatsSummaries AiStatsSummary[]
}

model Workout {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title               String
  date                String
  startTime           String
  endTime             String
  emoji               String   @default("happy")
  emojiBg             String   @default("yellow")
  marker              String   @default("blue")
  icon                String?
  exercises           String   @default("[]")
  notes               String?
  notifyMinutesBefore Int?
  completed           Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Token {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TokenType
  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model Program {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  goal        String?
  data        String   @default("{}") // JSON: { days: ProgramDay[] }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// A purchasable subscription plan. Prices are stored in kopecks so they map
// directly onto T-Bank's `Amount` field without rounding. Fully editable from
// the admin panel.
model Plan {
  id            String         @id @default(cuid())
  name          String
  priceKopecks  Int
  periodDays    Int
  active        Boolean        @default(true)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
  payments      Payment[]
}

// A user's subscription state. One row per user (reused across renewals).
// `rebillId` is the saved-card token returned by T-Bank on the first recurrent
// payment; it is used to auto-charge subsequent periods.
model Subscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId           String?
  plan             Plan?     @relation(fields: [planId], references: [id])
  status           String    @default("none") // none|pending|active|past_due|canceled|expired
  currentPeriodEnd DateTime?
  rebillId         String?
  autoRenew        Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  payments         Payment[]
}

// A single payment attempt against T-Bank. `orderId` is our own identifier
// (echoed back in the webhook); `tbankPaymentId` is T-Bank's PaymentId.
model Payment {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  planId         String?
  plan           Plan?         @relation(fields: [planId], references: [id])
  orderId        String        @unique
  tbankPaymentId String?
  amountKopecks  Int
  status         String        @default("NEW")
  isRecurrent    Boolean       @default(false)
  raw            String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

// Journal of every OpenAI call made on a user's behalf. Records token usage and
// an estimated ruble cost so the actual AI cost-per-subscriber is measurable.
// `feature` is 'program' | 'stats'; `status` is 'success' | 'error'.
// `estimatedCost` is in kopecks (Int) so it aggregates without float drift;
// null when the model's pricing is unknown.
model AiUsage {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature       String
  model         String
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  cachedTokens  Int      @default(0)
  estimatedCost Int?
  status        String   @default("success")
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, feature, status, createdAt])
}

// Persistent server-side cache of the monthly AI stats summary. Keyed by user
// and month; `payloadHash` is a hash of the aggregated stats the summary was
// built from, so an unchanged month is served from here without hitting OpenAI.
model AiStatsSummary {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthKey        String
  payloadHash     String
  summary         String
  sourceUpdatedAt DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, monthKey])
}

// Editable per-plan quota. Lets AI action allowances be tuned from data without
// a code change. `feature` is 'program' | 'stats'. Falls back to code constants
// when no row exists for a plan/feature.
model PlanLimit {
  id         String   @id @default(cuid())
  planId     String
  feature    String
  allowance  Int
  periodDays Int      @default(30)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([planId, feature])
}
